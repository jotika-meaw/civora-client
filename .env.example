# Client (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth (server-side, same MongoDB as Express)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/civora
BETTER_AUTH_SECRET=dev-only-change-me-min-32-chars-long-secret
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match Express JWT_ISSUER / JWT_AUDIENCE
JWT_ISSUER=civora
JWT_AUDIENCE=civora-client
